# ==============================================================================
# Copy this file to .env for local development, and set the same values as
# Environment Variables in your Vercel Project Settings for production.
# Every value below is a PLACEHOLDER — replace with values from your own
# Supabase project (Project Settings → API). Do not reuse anyone else's
# project URL or keys.
# ==============================================================================

# Client-side Supabase credentials (safe to expose in the browser bundle).
# Used for public reads and the live Realtime subscription.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-side Supabase credentials, used only by the /api/* serverless
# functions and by server.ts. These are never sent to the browser.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"

# Recommended: the service_role key lets the server write to the database
# even if you later tighten Row Level Security to block anon writes.
# NEVER prefix this with VITE_ and never expose it to the client.
