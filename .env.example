# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Client-side Supabase credentials (for public reads & Realtime subscription)
VITE_SUPABASE_URL="https://bzfxervcwhvoxpvfsnec.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-side Supabase credentials (for Vercel serverless /api routes)
SUPABASE_URL="https://bzfxervcwhvoxpvfsnec.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"

# Server-Side Privileged Key (Optional - for admin writes if RLS requires service_role)
# NEVER expose this key with VITE_ prefix
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
